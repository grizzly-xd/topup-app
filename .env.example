# ==== API BACKEND (WAJIB diisi di Vercel & lokal) ====
# Placeholder berikut BUKAN endpoint nyata. Ganti dengan URL backend production Anda.
VITE_API_BASE_URL=https://your-backend.example.com

# ==== FIREBASE (dari Firebase Console > Project Settings > Web App) ====
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ==== MIDTRANS (Client Key boleh public, Server Key JANGAN) ====
# Sandbox: https://app.sandbox.midtrans.com/snap/snap.js
# Production: https://app.midtrans.com/snap/snap.js
VITE_MIDTRANS_CLIENT_KEY=
VITE_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
VITE_MIDTRANS_IS_PRODUCTION=false

# ==== BRANDING (opsional, sesuaikan pemilik website) ====
VITE_SITE_NAME="TopUp Saldo"
VITE_CONTACT_EMAIL=""
VITE_CONTACT_PHONE=""
